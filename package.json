{
  "name": "cloudtak-plugin-sidebar-configurator",
  "version": "2.0.0",
  "type": "module",
  "description": "CloudTAK plugin \u2014 admin default sidebar layouts (Off / New Users Only / Forced) for standard users and admins",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/ValleyTacticalSolutions/cloudtak-plugin-sidebar-configurator.git"
  },
  "cloudtak": {
    "minVersion": "14.4.1"
  },
  "main": "index.js",
  "scripts": {
    "verify": "bash verify-cloudtak.sh . sidebar-configurator",
    "build:bundle": "vite build --config vite.bundle.config.ts",
    "bundle": "npm run build:bundle && node scripts/bundle.mjs"
  },
  "cloudtakBundle": {
    "name": "sidebar-configurator",
    "author": "ValleyTacticalSolutions",
    "homepage": "https://github.com/ValleyTacticalSolutions/cloudtak-plugin-sidebar-configurator"
  },
  "devDependencies": {
    "@tabler/icons-vue": "^3.0.0",
    "@tak-ps/vue-tabler": "^6.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "pinia": "^4.0.0",
    "sortablejs": "^1.15.6",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vite-plugin-css-injected-by-js": "^3.5.0",
    "vue": "^3.5.0",
    "vue-router": "^5.0.0"
  }
}
